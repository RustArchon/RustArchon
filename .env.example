# Copy this file to .env (already gitignored) and fill in real values before running
# `docker compose up`. .env is read automatically by Docker Compose from the same directory as the
# compose file - see docker-compose.yml's ${VAR} references.
#
# Every name here is a Docker Compose substitution variable - Compose resolves these references
# against this file while parsing docker-compose.yml, before the containers ever start. Most pass
# straight through into the containers under this exact same name, with no rename in between:
# - RUSTARCHON_* names (RUSTARCHON_INTERNAL_API_KEY, RUSTARCHON_ADMIN_EMAIL, ...) - RustArchon's own
#   code reads that literal key name directly.
# - POSTGRES_PASSWORD and RABBITMQ_DEFAULT_USER/PASS - these are NOT RustArchon-specific names; they're
#   the exact names the official postgres/rabbitmq images themselves require, so there's no separate
#   RustArchon-prefixed variable mapped onto them - using the image's own name directly avoids a
#   pointless second name to keep in sync.
# The one exception: RUSTARCHON_JWT_SECRET_KEY still becomes JwtSettings__SecretKey inside the
# containers, because that specific key path is hardcoded inside JumpStart (a framework dependency
# this repo doesn't fork) - see docker-compose.yml's environment blocks for exactly which value feeds
# which name.

POSTGRES_PASSWORD=postgres
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Must be at least 32 characters and identical to whatever the two apps expect - see JwtSettings in
# both RustArchon.Api and RustArchon's appsettings.json.
RUSTARCHON_JWT_SECRET_KEY=CHANGE-ME-At-Least-32-Characters-Long-Please

# Shared secret between RustArchon.Api and RustArchon.Worker (and the Blazor web app's
# QueuedEmailSender) for the internal (non-JWT) endpoints - see InternalApiKeyAuthenticationHandler.
# Any long random string.
RUSTARCHON_INTERNAL_API_KEY=CHANGE-ME-Another-Long-Random-String

# Soft-launch sign-up gate's *initial* value only - see PlatformSettingsRegistry. RustArchon.Api reads
# this exactly once, the very first time it seeds the PlatformSetting table; after that, use the
# platform-settings admin page to flip it - this variable is no longer consulted, and no longer needs
# a restart or a code change to change.
RUSTARCHON_INVITATION_CODES_ENABLED=true
# The email address (must match your RustArchon login) allowed to manage invitation codes at
# /Admin/InvitationCodes. Leave blank to lock that page out entirely.
RUSTARCHON_ADMIN_EMAIL=

# One-time bootstrap: on a fresh deployment there are no accounts and no invitation codes yet, so
# nobody - including the intended admin - can register. Set this to any code you like (e.g. a random
# string) alongside RUSTARCHON_ADMIN_EMAIL above; on startup, RustArchon.Api seeds a single-use
# invitation code with this value, bound to that email. Register at /Account/Register with that exact
# email/code pair to claim the platform-admin account - you'll end up an Owner of your own tenant (the
# normal sign-up flow) and a platform admin (your email already matches RUSTARCHON_ADMIN_EMAIL) in one
# step. Safe to leave set after that - seeding is idempotent and won't touch an already-redeemed code.
RUSTARCHON_ADMIN_CODE=

# Cross-subdomain SSO between rustarchon-panel and rustarchon-web (see the README's cross-app
# session section) - leave unset for local/plain-port deployments, where both services already
# share cookies as the same hostname on different ports. Set to .rustarchon.com (leading dot) only
# once rustarchon-panel and rustarchon-web are actually fronted by their real www./panel. subdomains.
COOKIE_DOMAIN=
